# Copie para .env; estes valores são somente para desenvolvimento local/CI.
# Nunca coloque segredos reais neste arquivo ou no Git.

# Compose / imagens
GHCR_OWNER=local
IMAGE_TAG=dev

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_DB=postgres
# Defaults for running a service directly outside Compose.
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=change-me-local-postgres

# Defaults for running a service directly outside Compose.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:29092,localhost:39092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# Keycloak local
KEYCLOAK_ADMIN=local-admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-admin
KEYCLOAK_REALM=food-ordering
KEYCLOAK_CLIENT_ID=food-ordering-client
KEYCLOAK_CLIENT_SECRET=change-me-local-client
KEYCLOAK_TEST_USER=performance-user
KEYCLOAK_TEST_PASSWORD=change-me-local-user

# Opcional: sobrescreva somente se a rede Compose tiver outro nome.
# K6_DOCKER_NETWORK=food-ordering-system_food-ordering-system
